# GitHub (optional but strongly recommended — increases limit from 60 to 5000 req/hr)
GITHUB_TOKEN=

# LLM — Google Gemini OpenAI-compatible API
OPENAI_API_KEY=your_gemini_api_key
OPENAI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.6-flash

# GitHub indexing limits (optional)
# MAX_REPOS=0        # 0 = all repos (requires GITHUB_TOKEN); default: 0
# MAX_FILES_PER_REPO=50  # files per repo to embed; default: 50
